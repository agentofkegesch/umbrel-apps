# Wyoming OpenAI Configuration
#
# This file allows you to customize settings for your Wyoming OpenAI installation.
# Changes to this file persist across app updates.
#
# After making changes, restart the app:
#   sudo ~/umbrel/scripts/app restart kegesch-wyoming-openai

# ============================================================================
# WYOMING PROTOCOL SETTINGS
# ============================================================================

# WYOMING_URI - The URI for the Wyoming server to bind to
# Default: tcp://0.0.0.0:10300
# Note: This should match the port specified in umbrel-app.yml
WYOMING_URI=tcp://0.0.0.0:10300

# WYOMING_LOG_LEVEL - Sets the logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
WYOMING_LOG_LEVEL=INFO

# WYOMING_LANGUAGES - Space-separated list of supported languages to advertise
# Default: en
# Examples: en, en es fr, en-US en-GB es-ES
WYOMING_LANGUAGES=en

# ============================================================================
# SPEECH-TO-TEXT (STT) CONFIGURATION
# ============================================================================

# STT_OPENAI_KEY - Optional API key for OpenAI-compatible STT services
# Required for: OpenAI, Groq, Mistral AI
# Not required for: LocalAI, Speaches (local backends)
# Default: (empty)
# STT_OPENAI_KEY=your_api_key_here

# STT_OPENAI_URL - The base URL for the OpenAI-compatible STT API
# LocalAI (Umbrel app): http://localai:8080/v1
# LocalAI (custom): http://your-host:8080/v1
# OpenAI: https://api.openai.com/v1
# Groq: https://api.groq.com/openai/v1
# Default: http://localai:8080/v1
STT_OPENAI_URL=http://localai:8080/v1

# STT_MODELS - Space-separated list of models to use for STT service
# LocalAI examples: whisper-base, whisper-small, whisper-medium, whisper-large-v3
# OpenAI examples: whisper-1, gpt-4o-transcribe, gpt-4o-mini-transcribe
# Groq examples: whisper-large-v3
# Default: whisper-base
STT_MODELS=whisper-base

# STT_STREAMING_MODELS - Space-separated list of STT models that support streaming
# These models will use streaming mode for real-time transcription
# Only supported by some backends (OpenAI gpt-4o-transcribe, etc.)
# Default: (empty - no streaming)
# STT_STREAMING_MODELS=gpt-4o-transcribe gpt-4o-mini-transcribe

# STT_BACKEND - Backend type to enable unofficial API feature sets
# Options: LOCALAI, OPENAI, GROQ, MISTRAL, EDGE_TTS, SPEACHES
# Default: LOCALAI (auto-detected if not set)
STT_BACKEND=LOCALAI

# STT_TEMPERATURE - Sampling temperature for speech-to-text
# Range: 0.0 to 1.0
# Lower values make the model more conservative, higher values more creative
# Default: (empty - auto-detected)
# STT_TEMPERATURE=0.0

# STT_PROMPT - Optional prompt to guide the model's transcription style
# Can be used to improve accuracy for specific domains
# Example: "This is a medical transcription."
# Default: (empty)
# STT_PROMPT=

# ============================================================================
# TEXT-TO-SPEECH (TTS) CONFIGURATION
# ============================================================================

# TTS_OPENAI_KEY - Optional API key for OpenAI-compatible TTS services
# Required for: OpenAI, Groq
# Not required for: LocalAI, Edge TTS, Speaches (local backends)
# Default: (empty)
# TTS_OPENAI_KEY=your_api_key_here

# TTS_OPENAI_URL - The base URL for the OpenAI-compatible TTS API
# LocalAI (Umbrel app): http://localai:8080/v1
# LocalAI (custom): http://your-host:8080/v1
# OpenAI: https://api.openai.com/v1
# Groq: https://api.groq.com/openai/v1
# Edge TTS: http://openai-edge-tts:8000/v1
# Default: http://localai:8080/v1
TTS_OPENAI_URL=http://localai:8080/v1

# TTS_MODELS - Space-separated list of models to use for TTS service
# LocalAI examples: en-us-amy-low.onnx, en-us-amy-medium.onnx, en-us-lessac-low.onnx
# OpenAI examples: tts-1, tts-1-hd, gpt-4o-mini-tts
# Groq examples: orpheus-2b
# Edge TTS examples: en-US-JennyNeural, en-US-GuyNeural
# Default: en-us-amy-low.onnx
TTS_MODELS=en-us-amy-low.onnx

# TTS_VOICES - Space-separated list of voices for TTS
# Only used by some backends (OpenAI, Edge TTS)
# OpenAI voices: alloy, ash, coral, echo, fable, onyx, nova, sage, shimmer
# Edge TTS: Many options (en-US-JennyNeural, en-US-GuyNeural, etc.)
# Default: (empty - auto-detected for supported backends)
# TTS_VOICES=alloy

# TTS_BACKEND - Backend type to enable unofficial API feature sets
# Options: LOCALAI, OPENAI, GROQ, EDGE_TTS, SPEACHES, KOKORO, CHATTERBOX
# Default: LOCALAI (auto-detected if not set)
TTS_BACKEND=LOCALAI

# TTS_SPEED - Speed of the TTS output
# Range: 0.25 to 4.0
# Default: 1.0
# TTS_SPEED=1.0

# TTS_INSTRUCTIONS - Optional instructions to control the TTS voice
# Can be used to adjust emotion, tone, or style
# Example: "Speak in a cheerful and excited tone."
# Default: (empty)
# TTS_INSTRUCTIONS=

# TTS_STREAMING_MODELS - Space-separated list of TTS models to enable streaming
# Streaming chunks text at sentence boundaries for faster audio delivery
# Requires backend support
# Default: (empty - no streaming)
# TTS_STREAMING_MODELS=tts-1

# TTS_STREAMING_MIN_WORDS - Minimum words per text chunk for streaming TTS
# Optional - helps control chunking behavior
# Default: (empty)
# TTS_STREAMING_MIN_WORDS=5

# TTS_STREAMING_MAX_CHARS - Maximum characters per text chunk for streaming TTS
# Optional - helps control chunking behavior
# Default: (empty)
# TTS_STREAMING_MAX_CHARS=200

# ============================================================================
# COMMON BACKEND EXAMPLES
# ============================================================================

# Example 1: Official OpenAI (cloud)
# STT_OPENAI_KEY=sk-your-openai-key
# TTS_OPENAI_KEY=sk-your-openai-key
# STT_OPENAI_URL=https://api.openai.com/v1
# TTS_OPENAI_URL=https://api.openai.com/v1
# STT_MODELS=whisper-1 gpt-4o-transcribe
# TTS_MODELS=gpt-4o-mini-tts tts-1-hd
# STT_BACKEND=OPENAI
# TTS_BACKEND=OPENAI

# Example 2: Groq (fast cloud inference)
# STT_OPENAI_KEY=gsk-your-groq-key
# TTS_OPENAI_KEY=gsk-your-groq-key
# STT_OPENAI_URL=https://api.groq.com/openai/v1
# TTS_OPENAI_URL=https://api.groq.com/openai/v1
# STT_MODELS=whisper-large-v3
# TTS_MODELS=orpheus-2b
# STT_BACKEND=GROQ
# TTS_BACKEND=GROQ

# Example 3: Microsoft Edge TTS (free, no API key)
# STT_OPENAI_URL=http://openai-edge-tts:8000/v1
# TTS_OPENAI_URL=http://openai-edge-tts:8000/v1
# STT_MODELS=en-US-JennyNeural
# TTS_MODELS=en-US-JennyNeural
# STT_BACKEND=EDGE_TTS
# TTS_BACKEND=EDGE_TTS

# Example 4: Mixed backends (LocalAI for STT, OpenAI for TTS)
# STT_OPENAI_URL=http://localai:8080/v1
# TTS_OPENAI_KEY=sk-your-openai-key
# STT_OPENAI_URL=https://api.openai.com/v1
# STT_MODELS=whisper-base
# TTS_MODELS=gpt-4o-mini-tts
# STT_BACKEND=LOCALAI
# TTS_BACKEND=OPENAI
